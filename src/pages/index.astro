---
import BaseTinta from '../layouts/BaseTinta.astro'
import DeviceFrame from '../components/tinta/DeviceFrame.astro'
import Hero from '../components/tinta/screens/Hero.astro'
import Demo from '../components/tinta/screens/Demo.astro'
import Pasos from '../components/tinta/screens/Pasos.astro'
import Comparativa from '../components/tinta/screens/Comparativa.astro'
import Privacidad from '../components/tinta/screens/Privacidad.astro'
import Faq1 from '../components/tinta/screens/Faq1.astro'
import Faq2 from '../components/tinta/screens/Faq2.astro'
import Cta from '../components/tinta/screens/Cta.astro'
import { hero } from '../content/copy'

/**
 * Control — concepto B, "La página es tinta electrónica" (Fase 6 de
 * `launch-squad`, ganadora de la ronda 3 de divergencia, MAK-143).
 * Sustituye la pila de siete secciones del control anterior (MAK-95): esta
 * página es un "dispositivo" de una sola pantalla que se pasa como un
 * libro — flash de inversión + fantasma de la pantalla anterior al cambiar,
 * índice navegable, salvapantallas por inactividad.
 *
 * Composición propia del concepto, no heredada: FAQ va antes que el CTA
 * (construye el argumento y cierra dudas antes de pedir el correo), al
 * revés que el control. `scripts/verificar.mjs` tiene su propio orden para
 * esta ruta (`ORDEN_TINTA`) — las variantes `/a/` y `/b/`, descartadas en
 * rondas anteriores y sin tocar aquí, siguen con el orden clásico.
 *
 * Todo el texto sale de `content/copy.ts` literal. El motor de paso de
 * página vive en `lib/tinta-reader.ts`; la demo y el formulario son los
 * componentes reales del control (`secciones/Demo.astro`,
 * `WaitlistForm.astro`), reskinados en `styles/global-tinta.css`.
 */
---

<BaseTinta ogTitle={hero.titular} path="/">
  <DeviceFrame>
    <Hero />
    <Demo />
    <Pasos />
    <Comparativa />
    <Privacidad />
    <Faq1 />
    <Faq2 />
    <Cta />
  </DeviceFrame>
</BaseTinta>
