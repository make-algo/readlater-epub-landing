---
import BaseB from '../../layouts/BaseB.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import HeroB from '../../components/secciones/b/Hero.astro'
import DemoB from '../../components/secciones/b/Demo.astro'
import Pasos from '../../components/secciones/Pasos.astro'
import ComparativaB from '../../components/secciones/b/Comparativa.astro'
import Privacidad from '../../components/secciones/Privacidad.astro'
import Cta from '../../components/secciones/Cta.astro'
import Faq from '../../components/secciones/Faq.astro'
import { hero } from '../../content/copy'

/**
 * Variante D — "Ficha técnica / dossier" (Fase 4 ronda 2 de `launch-squad`,
 * MAK-124). Publicada en `/b/`, reemplaza el contenido de la variante B de
 * la ronda 1 (MAK-100, descartada).
 *
 * Mismas siete secciones, mismo orden, mismo copy y mismo formulario que el
 * control (`/`, MAK-95): Héroe, Demo, Cómo funciona, Comparativa, Privacidad,
 * CTA, FAQ. Solo Héroe, Demo y Comparativa tienen maquetación propia — Cómo
 * funciona, Privacidad, CTA y FAQ son los mismos componentes del control sin
 * tocar una línea, y cambian de piel porque heredan los tokens visuales de
 * `tokens-b.css` en vez de los de `tokens.css`.
 */
---

<BaseB ogTitle={hero.titular} path="/b/">
  <Header />

  <main id="contenido">
    <HeroB />
    <DemoB />
    <Pasos />
    <ComparativaB />
    <Privacidad />
    <Cta />
    <Faq />
  </main>

  <Footer />
</BaseB>
