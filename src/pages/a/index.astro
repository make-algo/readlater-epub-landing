---
import BaseA from '../../layouts/BaseA.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import DemoA from '../../components/secciones/DemoA.astro'
import Pasos from '../../components/secciones/Pasos.astro'
import ComparativaA from '../../components/secciones/ComparativaA.astro'
import Privacidad from '../../components/secciones/Privacidad.astro'
import Cta from '../../components/secciones/Cta.astro'
import Faq from '../../components/secciones/Faq.astro'
import { hero } from '../../content/copy'

/**
 * Variante A (MAK-99, Fase 4 de `launch-squad`) — "El objeto es el mensaje".
 * Mismo copy, mismo orden de siete secciones y mismo formulario que el
 * control (MAK-95); lo que cambia es el sistema visual, aplicado en toda la
 * página vía `global-a.css`, y la maqueta propia de héroe/demo/comparativa.
 * Cómo funciona, Privacidad, CTA y FAQ heredan la composición del control
 * sin modificación — solo cambian los tokens que ya usan.
 */
---

<BaseA ogTitle={hero.titular} path="/a/">
  <Header />

  <main id="contenido">
    <section id="hero" class="wrap" style="padding-top: clamp(2.5rem, 6vw, 4.5rem);">
      <p class="eyebrow">ReadLater EPUB</p>
      <h1 style="margin-top: 1.25rem;">{hero.titular}</h1>
      <p class="lead" style="margin-top: 1.25rem; font-style: italic;">{hero.subtitulo}</p>
      <p style="margin-top: 1.75rem;">
        <a class="btn" href="#lista-de-espera">{hero.cta}</a>
      </p>
    </section>

    <DemoA />
    <Pasos />
    <ComparativaA />
    <Privacidad />
    <Cta />
    <Faq />
  </main>

  <Footer />
</BaseA>
