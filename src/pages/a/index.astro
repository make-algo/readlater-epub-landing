---
import BaseA from '../../layouts/BaseA.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import DemoA from '../../components/secciones/DemoA.astro'
import Pasos from '../../components/secciones/Pasos.astro'
import ComparativaA from '../../components/secciones/ComparativaA.astro'
import Privacidad from '../../components/secciones/Privacidad.astro'
import Cta from '../../components/secciones/Cta.astro'
import Faq from '../../components/secciones/Faq.astro'
import { hero } from '../../content/copy'

/**
 * Variante C (MAK-123, Fase 4 ronda 2 de `launch-squad`) — "Revista
 * editorial". Mismo copy, mismo orden de siete secciones y mismo formulario
 * que el control (MAK-95); lo que cambia es la idea organizadora: la página
 * se lee como la apertura de una revista impresa, no como pantallas de app.
 * Retícula asimétrica de columnas en el héroe, filetes en vez de tarjetas,
 * la demo como spread de doble página y la comparativa como tabla editorial
 * — aplicado vía `global-a.css`. Cómo funciona, Privacidad, CTA y FAQ
 * heredan la composición del control sin modificación; solo cambian los
 * tokens que ya usan.
 */
---

<BaseA ogTitle={hero.titular} path="/a/">
  <Header />

  <main id="contenido">
    <section id="hero" class="wrap hero-masthead">
      <div class="hero-masthead-meta">
        <p class="eyebrow">ReadLater EPUB</p>
        <p class="hero-marca" aria-hidden="true">Recordatorios<br />→ EPUB<br />→ Kindle</p>
      </div>
      <div class="hero-masthead-copy">
        <h1>{hero.titular}</h1>
      </div>
      <div class="hero-masthead-support">
        <p class="lead">{hero.subtitulo}</p>
        <p style="margin-top: 1.5rem;">
          <a class="btn-ghost" href="#lista-de-espera">{hero.cta}</a>
        </p>
      </div>
    </section>

    <DemoA />
    <Pasos />
    <ComparativaA />
    <Privacidad />
    <Cta />
    <Faq />
  </main>

  <Footer />
</BaseA>
