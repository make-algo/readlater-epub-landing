---
import { faq } from '../../../content/copy'

const preguntas = faq.preguntas.slice(0, 3)
---

<section class="screen" id="screen-5" data-title={`${faq.nombre} — 1/2`}>
  <div class="screen-inner">
    <h2>{faq.nombre}</h2>
    <div class="faq-list">
      {
        preguntas.map((p) => (
          <div class="faq-item">
            <h3>{p.q}</h3>
            <p>{p.a}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
