---
import { comparativa } from '../../content/copy'

/**
 * Control — la comparativa como cotejo, no como dos tarjetas gemelas: la
 * opción descartada se lee fragmentada (columna estrecha, tipografía de
 * sistema, cortada por una segunda línea corta) y la elegida se lee como
 * objeto encuadernado (columna ancha, lomo de acento a la izquierda,
 * titular a escala de libro). El eje es framing + escala, igual que
 * documenta docs/design/04-composicion-secciones-heredadas.md para el resto
 * de secciones heredadas — antes, aquí solo cambiaba el color de fondo.
 */
---

<section id="comparativa" class="wrap">
  <p class="eyebrow">Comparativa</p>
  <h2>{comparativa.nombre}</h2>

  <div class="cotejo">
    <div class="cotejo-perdida" data-fila-comparativa>
      <h3>{comparativa.sendToKindle.titulo}</h3>
      <p>{comparativa.sendToKindle.texto}</p>
    </div>
    <div class="cotejo-ganada" data-fila-comparativa>
      <h3>{comparativa.readlater.titulo}</h3>
      <p>{comparativa.readlater.texto}</p>
    </div>
  </div>

  <p class="lead" style="margin-top: 1.5rem;">{comparativa.otros}</p>
</section>
