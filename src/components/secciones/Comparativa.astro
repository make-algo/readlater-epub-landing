---
import { comparativa } from '../../content/copy'

/**
 * Control, ronda 3 (MAK-121) — la comparativa como corrección de
 * manuscrito, no como cotejo de dos columnas (MAK-109/110): la opción
 * descartada se tacha en línea, dentro de la misma frase, y la respuesta la
 * corrige justo a continuación — una sola frase que fluye como prosa, no
 * dos bloques uno junto al otro. Ver docs/design/04-composicion-secciones-
 * heredadas.md para la prueba de scroll que justifica el cambio.
 */
---

<section id="comparativa" class="wrap">
  <p class="eyebrow">Comparativa</p>
  <h2>{comparativa.nombre}</h2>

  <p class="correccion">
    <span class="correccion-fuera"><del>{comparativa.sendToKindle.titulo}</del>: {comparativa.sendToKindle.texto}</span>
    <span class="correccion-dentro"><ins>{comparativa.readlater.titulo}</ins>: {comparativa.readlater.texto}</span>
  </p>

  <p class="lead" style="margin-top: 1.5rem;">{comparativa.otros}</p>
</section>
