---
import { comparativa } from '../../content/copy'

/**
 * Variante C — la comparativa como tabla de contenidos editorial: numeral en
 * serif itálica, filete doble como cabecera de tabla, filas separadas por
 * hairlines y la fila elegida marcada por un lomo de acento — no dos
 * columnas gemelas ni dos tarjetas. Mismo copy y mismo orden que el control.
 */
---

<section id="comparativa" class="wrap">
  <p class="eyebrow">Comparativa</p>
  <h2>{comparativa.nombre}</h2>

  <div class="tabla-editorial-wrap">
    <table class="tabla-editorial">
      <caption class="sr-only">Comparativa entre Send to Kindle y ReadLater EPUB</caption>
      <thead>
        <tr>
          <th scope="col">N.º</th>
          <th scope="col">Opción</th>
          <th scope="col">Qué te da</th>
        </tr>
      </thead>
      <tbody>
        <tr class="fila-descartada">
          <td class="num">01</td>
          <td><h3>{comparativa.sendToKindle.titulo}</h3></td>
          <td>{comparativa.sendToKindle.texto}</td>
        </tr>
        <tr class="fila-elegida">
          <td class="num">02</td>
          <td><h3>{comparativa.readlater.titulo}</h3></td>
          <td>{comparativa.readlater.texto}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="lead" style="margin-top: 1.5rem;">{comparativa.otros}</p>
</section>
