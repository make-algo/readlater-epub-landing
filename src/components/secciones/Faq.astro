---
import { faq } from '../../content/copy'
---

<section id="faq" class="wrap">
  <p class="eyebrow">FAQ</p>
  <h2>{faq.nombre}</h2>

  <dl class="indice">
    {
      faq.preguntas.map((p, i) => (
        <div class="indice-entrada">
          <dt>
            <span class="indice-num" aria-hidden="true">{`${i + 1}.`}</span>
            <h3>{p.q}</h3>
          </dt>
          <dd style="margin-top: 0.4rem; margin-inline-start: 0; color: var(--color-ink-2);">{p.a}</dd>
        </div>
      ))
    }
  </dl>

  <p style="margin-top: 2.5rem;">
    <a class="btn" href="#lista-de-espera">{faq.cta}</a>
  </p>
</section>
