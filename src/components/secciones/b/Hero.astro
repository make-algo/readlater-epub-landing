---
import { hero } from '../../../content/copy'

/**
 * Héroe, variante D — "Correspondencia" (Fase 4, ronda 2, MAK-120). Contexto
 * limpio: no parte del héroe de la ronda 1 (MAK-100, "Ya lo conoces"),
 * borrado en este mismo cambio.
 *
 * El argumento no es "una app hace algo": es que un enlace guardado está en
 * el sitio equivocado (el móvil) y esto lo reubica en el sitio correcto (el
 * Kindle) — tratado literalmente como una pieza de correo que se reexpide.
 * El bloque de la derecha son dos matasellos conectados por la ruta de
 * reexpedición: MÓVIL, tachado con el mismo trazo rojo del sello; KINDLE,
 * sellado en la tinta de "entregado". Ningún icono de sobre de librería —
 * el propio matasellos, mecanografiado, es el material.
 *
 * La página no centra el bloque: el titular cuelga de una regla vertical,
 * como el margen de una hoja pautada, con el bloque de remite compensando
 * a la derecha en vez de debajo — asimetría real, no una columna con aire.
 *
 * Copy literal de `hero.*`, sin tocar.
 */
---

<section id="hero" class="wrap hero-carta">
  <div class="direccion">
    <p class="eyebrow">Correspondencia</p>
    <h1>{hero.titular}</h1>
    <p class="lead" style="margin-top: 1.25rem;">{hero.subtitulo}</p>
    <p style="margin-top: 1.75rem;">
      <a class="btn-ghost" href="#lista-de-espera">{hero.cta}</a>
    </p>
  </div>

  <div class="hero-carta__sello" aria-hidden="true">
    <div class="redireccion">
      <span class="redireccion__sello redireccion__sello--tachado"><span>Móvil</span></span>
      <svg class="redireccion__flecha" width="34" height="16" viewBox="0 0 34 16">
        <path d="M1 8h26M20 1.5l7 6.5-7 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="3 3" />
      </svg>
      <span class="redireccion__sello redireccion__sello--destino">Kindle</span>
    </div>
    <p class="hero-carta__leyenda"><span></span>Reexpedido</p>
  </div>
</section>

<style>
  .hero-carta {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: end;
  }
  .hero-carta__sello {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    justify-self: start;
  }
  .hero-carta__leyenda {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .hero-carta__leyenda span {
    display: block;
    width: 1rem;
    height: 2px;
    background: var(--color-ink-3);
  }
  @media (min-width: 56rem) {
    .hero-carta__leyenda { flex-direction: row-reverse; }
  }

  @media (min-width: 56rem) {
    .hero-carta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      align-items: end;
    }
    .hero-carta__sello {
      justify-self: end;
      align-items: flex-end;
      text-align: right;
      padding-bottom: 0.5rem;
    }
  }
</style>
