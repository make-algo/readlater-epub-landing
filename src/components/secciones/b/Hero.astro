---
import { hero } from '../../../content/copy'

/**
 * Héroe, variante B (Fase 4, MAK-100) — ronda 3 tras dos críticas ciegas
 * (6/2 y 5/2: "podría ser cualquier SaaS", "nada dice libro o Kindle").
 * Se retira el color decorativo sin criterio (los cuadrados de color por
 * dominio) y se sustituye el gesto central por uno que sí es exclusivo de
 * "esto se convierte en un libro": puntos guía entre título y número de
 * página, el mismo recurso tipográfico de un índice impreso — o el de
 * Apple Books — no un icono de librería. El gráfico muestra el arco
 * completo sin repetir la demo: arriba, los enlaces tal como llegan
 * (guardados, con dominio, el enlace ENRIQUECIDO real de Recordatorios que
 * ninguna API pública expone); abajo, esos mismos títulos ya convertidos
 * en índice, con folio.
 *
 * Copy literal de `hero.*`, sin tocar.
 */

const guardados = [
  { dominio: 'nytimes.com', titulo: 'El caso de la lectura larga en e-ink' },
  { dominio: 'newyorker.com', titulo: 'Notas sobre escribir con calma' },
  { dominio: 'aeon.co', titulo: 'Un repaso a la semana en enlaces' },
]

const convertidos = [
  { titulo: 'El caso de la lectura larga en e-ink', folio: 27 },
  { titulo: 'Notas sobre escribir con calma', folio: 11 },
]
---

<section id="hero" class="wrap" style="padding-top: clamp(2.5rem, 6vw, 4.5rem); display: grid; gap: clamp(2.5rem, 6vw, 4rem); align-items: start;">
  <div>
    <h1>{hero.titular}</h1>
    <p class="lead" style="margin-top: 1.25rem;">{hero.subtitulo}</p>
    <p style="margin-top: 1.75rem;">
      <a class="btn-ghost" href="#lista-de-espera">{hero.cta}</a>
    </p>
  </div>

  <div aria-hidden="true">
    <p class="eyebrow">Recordatorios</p>
    <div style="margin-top: 0.75rem; border-top: 1px solid var(--color-line);">
      {
        guardados.map((g) => (
          <div class="linkrow">
            <span>
              <span class="linkrow__titulo">{g.titulo}</span>
              <span class="linkrow__dominio">{g.dominio}</span>
            </span>
            <svg class="linkrow__check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" fill="none" stroke="var(--color-ink-3)" stroke-width="1.6" /></svg>
          </div>
        ))
      }
    </div>

    <p class="eyebrow" style="margin-top: 1.75rem; display: flex; align-items: center; gap: 0.5rem;">
      <svg width="14" height="14" viewBox="0 0 24 14" style="flex:none;"><path d="M1 7h20M15 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Convertidos
    </p>
    <div style="margin-top: 0.5rem; border-top: 1px solid var(--color-line);">
      {
        convertidos.map((c) => (
          <div class="indexrow">
            <svg class="indexrow__check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" fill="var(--color-check)" /><path d="M7.5 12.5 L10.3 15.3 L16.5 8.5" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="indexrow__titulo">{c.titulo}</span>
            <span class="indexrow__leader"></span>
            <span class="indexrow__folio">{c.folio}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  #hero { grid-template-columns: 1fr; }
  @media (min-width: 56rem) {
    #hero { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); }
  }
</style>
