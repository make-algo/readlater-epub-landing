---
import { hero } from '../../../content/copy'

/**
 * Héroe, variante D — "Ficha técnica / dossier" (Fase 4 ronda 2, MAK-124).
 * Reemplaza el héroe de la variante B de la ronda 1 (MAK-100): aquella
 * dirección organizaba la página como tarjetas de sistema operativo; esta
 * la organiza como el cajetín y la franja de especificaciones de un
 * documento técnico — retícula de líneas, no de cajas.
 *
 * El material propio no es una superficie sino un dato: la franja
 * ENTRADA → PROCESO → SALIDA resume el arco completo del producto (enlace
 * guardado → proceso local → libro navegable) con el vocabulario de una
 * hoja de especificaciones, sin repetir la demo de abajo. Es decorativa
 * (aria-hidden): el mismo argumento ya está en el titular y el subtítulo.
 *
 * Copy literal de `hero.*`, sin tocar.
 */
---

<section id="hero" class="wrap" style="padding-top: clamp(2.5rem, 6vw, 4.5rem);">
  <div class="ficha-doc__bar">
    <span class="ficha-doc__id">Ficha 01 — Producto</span>
    <span>Estado: beta cerrada</span>
  </div>

  <h1>{hero.titular}</h1>
  <p class="lead" style="margin-top: 1.25rem;">{hero.subtitulo}</p>
  <p style="margin-top: 1.75rem;">
    <a class="btn-ghost" href="#lista-de-espera">{hero.cta}</a>
  </p>

  <div class="specstrip" aria-hidden="true">
    <div class="specstrip__cell">
      <span class="specstrip__label">Entrada</span>
      <span class="specstrip__valor">Recordatorios · enlace enriquecido</span>
    </div>
    <div class="specstrip__cell">
      <span class="specstrip__label">Proceso</span>
      <span class="specstrip__valor">En tu Mac · sin servidor</span>
    </div>
    <div class="specstrip__cell">
      <span class="specstrip__label">Salida</span>
      <span class="specstrip__valor">EPUB único · índice navegable</span>
    </div>
  </div>
</section>
