---
import { url } from '../../../lib/site'
import { demo } from '../../../content/copy'

/**
 * Sección 2 — Demo, variante B (Fase 4, MAK-100) — ronda 2. Mismo contenido
 * y mismas cadenas que el control (`demo.*`, sin tocar). Ya no hay ventana
 * de macOS envolviendo la imagen: las filas de la demo son la continuación
 * directa de las del héroe — mismo tipo de fila, ahora con folio y con el
 * check en verde — para leerse como una sola superficie, no como una segunda
 * maqueta distinta.
 */
---

<section id="demo" class="wrap">
  <p class="eyebrow">Demo</p>
  <h2>{demo.nombre}</h2>
  <p class="lead" style="margin-top: 0.75rem;">{demo.intro}</p>

  <figure style="margin-top: 2rem; max-width: 42rem; border-top: 1px solid var(--color-line);">
    <img
      src={url('/demo/indice-placeholder-b.svg')}
      alt={demo.indiceAlt}
      width="640"
      height="320"
      loading="lazy"
      data-placeholder={demo.placeholderId}
      style="width: 100%; height: auto; display: block;"
    />
    <figcaption style="margin-top: 0.75rem; color: var(--color-ink-3); font-size: var(--text-small);">
      {demo.rotulo}
    </figcaption>
  </figure>
</section>
