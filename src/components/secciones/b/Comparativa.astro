---
import { comparativa } from '../../../content/copy'

/**
 * Sección 4 — Comparativa, variante B (Fase 4, MAK-100) — ronda 2. Mismo
 * copy y mismo argumento que el control. Dos filas sueltas sobre el lienzo,
 * sin tarjeta ni fondo de color — el crítico de la ronda 1 señaló que la
 * tarjeta con fondo azul mezclaba vocabulario de formulario con lo que es
 * una comparación editorial. El check en verde ya dice cuál gana; no hace
 * falta subrayarlo también con un fondo.
 */
---

<section id="comparativa" class="wrap">
  <p class="eyebrow">Comparativa</p>
  <h2>{comparativa.nombre}</h2>

  <div style="margin-top: 2rem; max-width: 42rem; border-top: 1px solid var(--color-line);">
    <div class="linkrow" data-fila-comparativa>
      <svg class="listrow__check" viewBox="0 0 24 24" width="24" height="24" style="flex:none; margin-top:0.15rem;"><circle cx="12" cy="12" r="9.5" fill="none" stroke="var(--color-ink-3)" stroke-width="1.6" /></svg>
      <div>
        <h3>{comparativa.sendToKindle.titulo}</h3>
        <p style="margin-top: 0.35rem; color: var(--color-ink-2);">{comparativa.sendToKindle.texto}</p>
      </div>
    </div>
    <div class="linkrow" data-fila-comparativa>
      <svg class="listrow__check" viewBox="0 0 24 24" width="24" height="24" style="flex:none; margin-top:0.15rem;">
        <circle cx="12" cy="12" r="9.5" fill="var(--color-check)" />
        <path d="M7.5 12.5 L10.3 15.3 L16.5 8.5" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <div>
        <h3>{comparativa.readlater.titulo}</h3>
        <p style="margin-top: 0.35rem; color: var(--color-ink-2);">{comparativa.readlater.texto}</p>
      </div>
    </div>
  </div>

  <p class="lead" style="margin-top: 1.5rem;">{comparativa.otros}</p>
</section>
