---
import { comparativa } from '../../../content/copy'

/**
 * Comparativa, variante D — "Correspondencia" (Fase 4, ronda 2, MAK-120).
 * Contexto limpio: no parte de la comparativa de la ronda 1 (MAK-100), de
 * dos filas sueltas — esta empieza de cero.
 *
 * Nada de tarjetas iguales con relleno distinto: texto corrido, como el
 * cuerpo de una carta, con la corrección al margen — el gesto de un
 * corrector de galeradas tachando una entrega y aprobando la otra, mismo
 * copy literal de `comparativa.*`, reordenado en prosa en vez de en grid.
 * La marca es tipográfica (tachado / subrayado), no una insignia de check
 * o cruz — eso ya es vocabulario de tabla de precios de SaaS.
 */
---

<section id="comparativa" class="wrap">
  <p class="eyebrow">Comparativa</p>
  <h2>{comparativa.nombre}</h2>

  <div class="carta">
    <div class="carta__fila">
      <div class="carta__parrafo">
        <h3>{comparativa.sendToKindle.titulo}</h3>
        <p>{comparativa.sendToKindle.texto}</p>
      </div>
      <div class="carta__nota carta__nota--rechazo">
        <span>{comparativa.sendToKindle.titulo}</span>
      </div>
    </div>

    <div class="carta__fila">
      <div class="carta__parrafo">
        <h3>{comparativa.readlater.titulo}</h3>
        <p>{comparativa.readlater.texto}</p>
      </div>
      <div class="carta__nota carta__nota--aprobado">
        <span>{comparativa.readlater.titulo}</span>
      </div>
    </div>

    <p class="lead carta__cierre">{comparativa.otros}</p>
  </div>
</section>
