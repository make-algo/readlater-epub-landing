---
import { demo } from '../../content/copy'

/**
 * Variante C — misma demo real que el control (epub.js, tres estados, tabs
 * accesibles en móvil; MAK-101), presentada como el spread de doble página
 * de una revista: una cabecera de página corrida encima (running head +
 * paginación de spread), un lomo/gutter central en vez de sombra de tarjeta,
 * y un pie de foto tipográfico en vez de chrome de ventana o mockup de
 * dispositivo. El spread sangra a ancho completo de viewport — es la única
 * prueba tangible del producto, así que es la pieza dominante de la página,
 * no un bloque más encajado en la retícula de texto (hallazgo de la crítica
 * a ciegas, rondas 1 y 2). Comportamiento compartido con el control, sin
 * tocar (`src/lib/demo.ts`); solo cambia la piel, en este bloque de estilos.
 */

const skeletonHtml = `<div class="skeleton">
  <div class="sk-line title"></div>
  <div class="sk-line w-90"></div>
  <div class="sk-line w-90"></div>
  <div class="sk-line w-60"></div>
  <div class="sk-line w-40" style="margin-top:8px"></div>
  <div class="sk-line w-90"></div>
  <div class="sk-line w-90"></div>
  <div class="sk-line w-60"></div>
</div>`
---

<section id="demo" class="demo-seccion" aria-label="Demostración interactiva: web original frente a EPUB generado">
  <div class="wrap">
    <p class="eyebrow">Demo</p>
    <h2>{demo.nombre}</h2>
    <p class="lead" style="margin-top: 0.75rem;">{demo.intro}</p>
  </div>

  <div class="spread-runninghead wrap" aria-hidden="true">
    <span>{demo.nombre}</span>
    <span class="spread-folio">Pág. 01 — 02</span>
  </div>

  <!-- ===== Escritorio / tablet: split-screen — sangra a ancho completo ===== -->
  <div class="demo-frame demo-grid" data-view="split">
    <div class="col">
      <div class="col-label"><span>{demo.colWeb}</span><span class="src">paulgraham.com</span></div>
      <div class="col-body" data-slot="web">
        <div class="demo-state demo-state--loading" data-role="loading" set:html={skeletonHtml} />
      </div>
    </div>
    <div class="col">
      <div class="col-label"><span>{demo.colEpub}</span><span class="src">{demo.colEpubFuente}</span></div>
      <div class="col-body" data-slot="epub">
        <div class="demo-state demo-state--loading" data-role="loading" set:html={skeletonHtml} />
      </div>
    </div>
  </div>

  <!-- ===== Móvil (<768px): tabs, nunca columnas encogidas ===== -->
  <div class="demo-frame demo-tabs" data-view="tabs">
    <div class="tablist" role="tablist" aria-label="Alternar entre la web original y el EPUB">
      <button type="button" role="tab" id="demo-tab-web" aria-controls="demo-panel-web" aria-selected="true">
        {demo.tabWeb}
      </button>
      <button type="button" role="tab" id="demo-tab-epub" aria-controls="demo-panel-epub" aria-selected="false" tabindex="-1">
        {demo.tabEpub}
      </button>
    </div>
    <div role="tabpanel" id="demo-panel-web" aria-labelledby="demo-tab-web" class="demo-panel active" data-slot="web-m">
      <div class="demo-state demo-state--loading" data-role="loading" set:html={skeletonHtml} />
    </div>
    <div role="tabpanel" id="demo-panel-epub" aria-labelledby="demo-tab-epub" class="demo-panel" data-slot="epub-m" hidden>
      <div class="demo-state demo-state--loading" data-role="loading" set:html={skeletonHtml} />
    </div>
  </div>

  <p class="demo-caption wrap">{demo.notaContenido}</p>
</section>

<style is:global>
  /*
   * `is:global`, a propósito, igual que en el control: buena parte de este
   * marcado (skeleton, iframe, lector EPUB, panel de índice) lo crea el
   * `<script>` de más abajo en el cliente. Los tokens locales apuntan a los
   * de `tokens-a.css` — el registro de esta sección es el de una revista
   * impresa, no el de un lector aparte.
   */
  .demo-seccion {
    --demo-paper: var(--color-paper-raised);
    --demo-paper-dim: var(--color-paper);
    --demo-ink: var(--color-ink);
    --demo-ink-soft: var(--color-ink-3);
    --demo-line: var(--color-line);
    --demo-accent: var(--color-accent);
    --demo-flag: var(--color-accent-strong);
    --demo-radius: 0;
    --demo-font-label: var(--font-sans);
    --demo-height: min(70vh, 620px);
  }

  /* -- Cabecera de página corrida: kicker repetido + paginación de spread,
     como la línea que corre por lo alto de una doble página de revista. */
  .spread-runninghead {
    margin-top: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--demo-ink-soft);
    border-top: 1px solid var(--demo-line);
    border-bottom: 1px solid var(--demo-line);
    padding-block: 0.55rem;
  }

  /* -- El spread en sí: sin sombra de tarjeta ni chrome de ventana, solo un
     filete superior grueso (el corte del pliego) y un lomo central que
     simula la costura entre las dos páginas. */
  .demo-frame {
    border-top: 3px solid var(--demo-ink);
    background: var(--demo-paper);
    color: var(--demo-ink);
    font-family: var(--font-serif);
  }

  .demo-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: var(--demo-height);
  }
  .demo-grid::before {
    /* Lomo del spread: sombra de pliegue en el centro, no un borde recto. */
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 22px;
    margin-left: -11px;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgb(0 0 0 / 0.09),
      transparent 42%,
      transparent 58%,
      rgb(0 0 0 / 0.09)
    );
  }

  .col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .col-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--demo-ink-soft);
    padding: 0.7rem 1.25rem;
    border-bottom: 1px solid var(--demo-line);
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .col-label .src {
    color: var(--demo-ink);
    font-style: normal;
    font-weight: 600;
  }

  .col-body {
    flex: 1 1 0;
    min-height: 0;
    position: relative;
    overflow: hidden;
  }

  .demo-state {
    position: absolute;
    inset: 0;
    overflow: auto;
  }
  .demo-state[hidden] {
    display: none;
  }

  .demo-state--content iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .iframe-scale-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }
  .iframe-scale-wrap iframe {
    display: block;
    border: 0;
    transform-origin: 0 0;
  }

  /* --- skeleton (carga) --- */
  .skeleton {
    padding: 1.25rem 1rem;
  }
  .sk-line {
    height: 12px;
    margin-bottom: 12px;
    border-radius: var(--demo-radius);
    background: linear-gradient(90deg, var(--demo-paper-dim), var(--demo-line), var(--demo-paper-dim));
    background-size: 200% 100%;
    animation: demo-sk-pulse 1.6s ease-in-out infinite;
  }
  @keyframes demo-sk-pulse {
    0% {
      background-position: 0% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
  .sk-line.w-60 {
    width: 60%;
  }
  .sk-line.w-90 {
    width: 90%;
  }
  .sk-line.w-40 {
    width: 40%;
  }
  .sk-line.title {
    height: 22px;
    width: 70%;
    margin-bottom: 20px;
  }

  /* --- error / fallback estático --- */
  .fallback img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(0.15);
  }
  .fallback-flag {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    background: var(--demo-paper);
    color: var(--demo-flag);
    border-bottom: 1px solid var(--demo-line);
    padding: 0.5rem 1rem;
  }

  .epub-error {
    padding: 1.25rem 1rem;
    color: var(--demo-ink-soft);
  }

  /* --- lector EPUB --- */
  .reader-shell {
    display: flex;
    height: 100%;
    min-height: 0;
  }
  .toc {
    width: 220px;
    flex: 0 0 220px;
    border-right: 1px solid var(--demo-line);
    overflow-y: auto;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .toc h3 {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--demo-ink-soft);
    margin: 0 1rem 0.5rem;
    font-weight: 700;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li a {
    display: block;
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: var(--demo-ink);
    border-left: 3px solid transparent;
    cursor: pointer;
  }
  .toc li a:hover {
    background: var(--demo-paper-dim);
  }
  .toc li a[aria-current='true'] {
    border-left-color: var(--demo-accent);
    background: var(--demo-paper-dim);
    font-weight: 600;
  }
  .reader-viewport {
    flex: 1 1 auto;
    min-width: 0;
    overflow-y: auto;
    padding: 1.75rem 2rem;
  }
  .reader-viewport h4 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
    color: var(--demo-ink);
  }
  .reader-viewport .meta {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    color: var(--demo-ink-soft);
    margin-bottom: 1.125rem;
  }
  .reader-viewport p {
    margin: 0 0 0.9rem;
  }

  /* -- Pie de foto tipográfico, no leyenda de sistema ---------------------- */
  .demo-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--demo-ink-soft);
    margin-top: 1rem;
  }
  .demo-caption::before {
    content: 'Fig. 1 — ';
    font-style: normal;
    font-weight: 700;
  }

  /* ============ Móvil: tabs en vez de columnas encogidas ============ */
  .demo-tabs {
    display: none;
  }
  @media (max-width: 767px) {
    .demo-grid {
      display: none;
    }
    .demo-tabs {
      display: block;
      --demo-height: 76vh;
    }

    .tablist {
      display: flex;
      border-bottom: 1px solid var(--demo-line);
    }
    .tablist [role='tab'] {
      flex: 1 1 50%;
      font-family: var(--font-sans);
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 700;
      background: var(--demo-paper);
      color: var(--demo-ink-soft);
      border: 0;
      padding: 0.875rem 0.5rem;
      cursor: pointer;
    }
    .tablist [role='tab'][aria-selected='true'] {
      color: var(--demo-ink);
      background: var(--demo-paper-dim);
      box-shadow: inset 0 -3px 0 var(--demo-accent);
    }
    .demo-panel {
      display: none;
      height: var(--demo-height);
      overflow: auto;
      position: relative;
    }
    .demo-panel.active {
      display: block;
    }
    .demo-panel .reader-shell {
      height: 100%;
    }
    .demo-panel .fallback {
      min-height: 100%;
    }
    .toc {
      width: 150px;
      flex: 0 0 150px;
    }
    .reader-viewport {
      padding: 1.25rem;
    }
    .spread-runninghead {
      font-size: 0.625rem;
    }
  }
</style>

<script>
  import {
    DEMO_EPUB_URL,
    DEMO_EPUBJS_SRC,
    DEMO_FALLBACK_IMG,
    DEMO_JSZIP_SRC,
    DEMO_WEB_URL,
  } from '../../lib/demo'
  import { demo as demoCopy } from '../../content/copy'

  declare const ePub: (url: string) => any

  const section = document.getElementById('demo')
  if (section) {
    const webSlot = section.querySelector<HTMLElement>('[data-slot="web"]')
    const epubSlot = section.querySelector<HTMLElement>('[data-slot="epub"]')
    const webSlotM = section.querySelector<HTMLElement>('[data-slot="web-m"]')
    const epubSlotM = section.querySelector<HTMLElement>('[data-slot="epub-m"]')

    // ---- carga en diferido de epub.js: solo cuando la demo se acerca al viewport ----
    let scriptsPromise: Promise<void> | null = null
    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script')
        s.src = src
        s.onload = () => resolve()
        s.onerror = () => reject(new Error(`No se ha podido cargar ${src}`))
        document.head.appendChild(s)
      })
    }
    // jszip tiene que cargar ANTES que epub.min.js: epub.js no lo trae
    // empaquetado y, sin él, book.open() se cuelga sin error visible
    // (ver docs/design/02-demo-embebida.md, hallazgo de validación).
    function loadEpubJs(): Promise<void> {
      if (!scriptsPromise) scriptsPromise = loadScript(DEMO_JSZIP_SRC).then(() => loadScript(DEMO_EPUBJS_SRC))
      return scriptsPromise
    }

    // ---- columna "web": iframe real con estado de carga/éxito/error ----
    const IFRAME_VIRTUAL_WIDTH = 600 // paulgraham.com no es responsive (ver spec de diseño)

    function fitIframe(container: HTMLElement, wrap: HTMLElement, iframe: HTMLIFrameElement) {
      const w = container.clientWidth
      const h = container.clientHeight
      if (w >= IFRAME_VIRTUAL_WIDTH) {
        iframe.style.width = '100%'
        iframe.style.height = '100%'
        iframe.style.transform = 'none'
      } else {
        const scale = w / IFRAME_VIRTUAL_WIDTH
        iframe.style.width = `${IFRAME_VIRTUAL_WIDTH}px`
        iframe.style.height = `${h / scale}px`
        iframe.style.transform = `scale(${scale})`
      }
    }

    function showFallback(container: HTMLElement) {
      const loading = container.querySelector<HTMLElement>('[data-role="loading"]')
      if (loading) loading.hidden = true
      let errorEl = container.querySelector<HTMLElement>('[data-role="error"]')
      if (!errorEl) {
        errorEl = document.createElement('div')
        errorEl.className = 'demo-state demo-state--error fallback'
        errorEl.dataset.role = 'error'
        errorEl.innerHTML =
          `<div class="fallback-flag">${demoCopy.fallbackAviso}</div>` +
          `<img src="${DEMO_FALLBACK_IMG}" alt="Captura estática de paulgraham.com/love.html, usada como alternativa cuando el iframe en vivo no carga" />`
        container.appendChild(errorEl)
      }
      errorEl.hidden = false
    }

    function mountWebColumn(container: HTMLElement) {
      let settled = false
      const timeout = window.setTimeout(() => {
        if (settled) return
        settled = true
        showFallback(container)
      }, 8000)

      const content = document.createElement('div')
      content.className = 'demo-state demo-state--content'
      content.dataset.role = 'content'
      content.hidden = true

      const wrap = document.createElement('div')
      wrap.className = 'iframe-scale-wrap'
      const iframe = document.createElement('iframe')
      iframe.title = `Web original: ${DEMO_WEB_URL}`
      iframe.referrerPolicy = 'no-referrer'

      iframe.addEventListener('load', () => {
        if (settled) return
        settled = true
        window.clearTimeout(timeout)
        const loading = container.querySelector<HTMLElement>('[data-role="loading"]')
        if (loading) loading.hidden = true
        content.hidden = false
        fitIframe(container, wrap, iframe)
        new ResizeObserver(() => fitIframe(container, wrap, iframe)).observe(container)
      })
      iframe.addEventListener('error', () => {
        if (settled) return
        settled = true
        window.clearTimeout(timeout)
        showFallback(container)
      })

      // El src se fija ANTES de insertar el iframe en el documento: si se
      // asigna después de conectarlo, el navegador ya ha empezado a cargar
      // su `about:blank` inicial y ese `load` espurio puede dispararse
      // antes que el de la navegación real, dando un falso estado de éxito
      // aunque la red esté bloqueada o tarde.
      iframe.src = DEMO_WEB_URL
      wrap.appendChild(iframe)
      content.appendChild(wrap)
      container.appendChild(content)
    }

    // ---- columna "epub": lector con panel de índice navegable ----
    const activeBooks: any[] = []

    function renderChapter(book: any, href: string, label: string, viewport: HTMLElement) {
      viewport.innerHTML = ''
      const h = document.createElement('h4')
      h.textContent = label
      viewport.appendChild(h)
      book
        .load(href)
        .then((doc: Document) => {
          const body = doc.querySelector('body')
          if (!body) return
          body.querySelectorAll('p').forEach((p) => {
            const clone = document.createElement('p')
            clone.textContent = p.textContent
            viewport.appendChild(clone)
          })
        })
        .catch((err: unknown) => {
          // Sin esto, un capítulo que falla a media lectura deja el
          // viewport vacío tras el título — indistinguible de un bug
          // (hallazgo de revisión, MAK-101).
          const p = document.createElement('p')
          p.textContent = demoCopy.lectorError
          viewport.appendChild(p)
          console.error('epub.js chapter load failed', err)
        })
    }

    function showEpubError(container: HTMLElement) {
      const loading = container.querySelector<HTMLElement>('[data-role="loading"]')
      if (loading) loading.hidden = true
      let errorEl = container.querySelector<HTMLElement>('[data-role="error"]')
      if (!errorEl) {
        errorEl = document.createElement('div')
        errorEl.className = 'demo-state demo-state--error epub-error'
        errorEl.dataset.role = 'error'
        errorEl.innerHTML = `<p>${demoCopy.lectorError}</p>`
        container.appendChild(errorEl)
      }
      errorEl.hidden = false
    }

    function mountEpubColumn(container: HTMLElement) {
      loadEpubJs()
        .then(() => {
          const book = ePub(DEMO_EPUB_URL)
          activeBooks.push(book)

          // book.opened NUNCA rechaza si la apertura falla: hay que escuchar
          // 'openFailed' aparte, si no la carga se queda colgada sin aviso
          // (hallazgo de docs/design/02-demo-embebida.md).
          book.on('openFailed', (err: unknown) => {
            showEpubError(container)
            console.error('epub.js openFailed', err)
          })

          book.loaded.navigation
            .then((nav: { toc: Array<{ label: string; href: string }> }) => {
              const content = document.createElement('div')
              content.className = 'demo-state demo-state--content'
              content.dataset.role = 'content'
              content.innerHTML =
                '<div class="reader-shell">' +
                '<nav class="toc" aria-label="Índice del EPUB"><h3>Índice</h3><ul data-toc-list></ul></nav>' +
                '<div class="reader-viewport" data-reader-viewport></div>' +
                '</div>'
              container.appendChild(content)

              const tocList = content.querySelector<HTMLElement>('[data-toc-list]')!
              const viewport = content.querySelector<HTMLElement>('[data-reader-viewport]')!

              nav.toc.forEach((item, i) => {
                const li = document.createElement('li')
                const a = document.createElement('a')
                a.href = '#'
                a.textContent = item.label.trim()
                a.setAttribute('aria-current', i === 0 ? 'true' : 'false')
                a.addEventListener('click', (ev) => {
                  ev.preventDefault()
                  tocList.querySelectorAll('a').forEach((x) => x.setAttribute('aria-current', 'false'))
                  a.setAttribute('aria-current', 'true')
                  renderChapter(book, item.href, item.label.trim(), viewport)
                })
                li.appendChild(a)
                tocList.appendChild(li)
              })
              if (nav.toc[0]) renderChapter(book, nav.toc[0].href, nav.toc[0].label.trim(), viewport)

              const loading = container.querySelector<HTMLElement>('[data-role="loading"]')
              if (loading) loading.hidden = true
            })
            .catch((err: unknown) => {
              showEpubError(container)
              console.error(err)
            })
        })
        .catch((err: unknown) => {
          showEpubError(container)
          console.error(err)
        })
    }

    // ---- montaje: una sola vez por breakpoint, para no duplicar la carga
    //      (iframe en vivo + fetch del EPUB) en el par que no se ve ----
    let desktopMounted = false
    let mobileMounted = false

    function mountDesktop() {
      if (desktopMounted || !webSlot || !epubSlot) return
      desktopMounted = true
      mountWebColumn(webSlot)
      mountEpubColumn(epubSlot)
    }
    function mountMobile() {
      if (mobileMounted || !webSlotM || !epubSlotM) return
      mobileMounted = true
      mountWebColumn(webSlotM)
      mountEpubColumn(epubSlotM)
    }

    const mqlMobile = window.matchMedia('(max-width: 767px)')
    function mountForViewport() {
      if (mqlMobile.matches) mountMobile()
      else mountDesktop()
    }
    mqlMobile.addEventListener('change', mountForViewport)

    // ---- arranque diferido: solo cuando la sección se acerca al viewport ----
    function boot() {
      loadEpubJs()
      mountForViewport()
    }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect()
            boot()
          }
        },
        { rootMargin: '200px 0px' },
      )
      io.observe(section)
    } else {
      boot()
    }

    // ---- tabs móviles ----
    const tabWeb = document.getElementById('demo-tab-web') as HTMLButtonElement | null
    const tabEpub = document.getElementById('demo-tab-epub') as HTMLButtonElement | null
    const panelWeb = document.getElementById('demo-panel-web')
    const panelEpub = document.getElementById('demo-panel-epub')

    if (tabWeb && tabEpub && panelWeb && panelEpub) {
      function selectTab(name: 'web' | 'epub') {
        const webSelected = name === 'web'
        tabWeb!.setAttribute('aria-selected', String(webSelected))
        tabEpub!.setAttribute('aria-selected', String(!webSelected))
        tabWeb!.tabIndex = webSelected ? 0 : -1
        tabEpub!.tabIndex = webSelected ? -1 : 0
        panelWeb!.hidden = !webSelected
        panelEpub!.hidden = webSelected
        panelWeb!.classList.toggle('active', webSelected)
        panelEpub!.classList.toggle('active', !webSelected)
      }
      tabWeb.addEventListener('click', () => selectTab('web'))
      tabEpub.addEventListener('click', () => selectTab('epub'))
      ;[tabWeb, tabEpub].forEach((tab, i, arr) => {
        tab.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowRight' || ev.key === 'ArrowLeft') {
            ev.preventDefault()
            const other = arr[(i + 1) % arr.length]
            other.focus()
            selectTab(other === tabWeb ? 'web' : 'epub')
          }
        })
      })
    }
  }
</script>
