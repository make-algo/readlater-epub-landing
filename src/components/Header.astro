---
import { url } from '../lib/site'
import { descargar } from '../content/copy'
import { descarga } from '../lib/descarga'

/**
 * Marca — serif para el nombre de lectura + etiqueta de sistema para el
 * formato, separadas por un filete (00-identidad-visual.md: "un filete de
 * 1-2px, como el lomo que separa dos páginas de un libro"). Antes era un
 * icono genérico + texto en negrita, indistinguible de cualquier cabecera
 * de SaaS. El enlace de descarga va en `.btn-ghost`: es refuerzo en las
 * páginas secundarias (privacidad, 404).
 */
---

<header class="wrap site-header">
  <a href={url('/')} class="marca">
    <img src={url('/favicon.svg')} alt="" width="22" height="22" />
    <span class="marca-texto">
      ReadLater
      <span class="marca-formato">EPUB</span>
    </span>
  </a>
  <a class="btn-ghost" href={descarga.url}>{descargar.boton}</a>
</header>
